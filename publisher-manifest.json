-radius:999px;padding:8px 20px;color:var(--txt)}\n.client .get:hover{border-color:var(--neon);color:var(--neon)}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n.faq{background:var(--ink-2);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 20px 40px rgba(0,0,0,.35);padding:28px 30px}\n.faq h3{font-size:16px;line-height:1.5;margin-bottom:12px}\n.faq h3::before{content:\"Q\";display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:var(--neon);color:var(--ink);font-size:13px;font-weight:800;margin-right:10px;vertical-align:2px}\n.faq p{color:var(--mut);font-size:15px}\n.faq p::before{content:\"A · \";color:var(--neon);font-weight:700}\n\n/* footer */\nfooter{padding:56px 0 64px;color:var(--mut);font-size:14px}\nfooter .brandline{color:var(--txt);font-weight:700;font-size:16px;margin-bottom:8px}\nfooter .brandline span{color:var(--neon)}\n\n@media (max-width:900px){\n  .hero-grid{grid-template-columns:1fr;gap:36px;padding:56px 0 44px}\n  .cards,.clients{grid-template-columns:1fr}\n  .faq-grid{grid-template-columns:1fr}\n  .step{grid-template-columns:1fr;gap:14px}\n  section{padding:64px 0}\n}\n</style><header class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"kicker\">KOODOG · 私家车</span>\n      <h1>KooDog私家车(KooDog) · KooDog私家车<br>自己的车，<em>自己开</em>。</h1>\n      <p class=\"lede\">三档套餐。价格写在明处。<strong>基础版 ¥15/月，旗舰版 ¥35/月，团队版 ¥85/月。</strong>年付再省两个月。没有隐藏项，没有套路页。</p>\n      <nav class=\"anchor-tags\" aria-label=\"页内导航\">\n        <a href=\"#features\">特点</a>\n        <a href=\"#plans\">套餐价格</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-solid\" href=\"#plans\">查看套餐</a>\n        <a class=\"btn btn-ghost\" href=\"#guide\">先看怎么用</a>\n      </div>\n    </div>\n    <aside class=\"panel\" aria-label=\"套餐速览\">\n      <h2>套餐速览</h2>\n      <dl>\n        <div class=\"row\">\n          <dt>基础版</dt>\n          <dd>¥15/月<small>年付 ¥150 · 100GB/月 · 3 台设备</small></dd>\n        </div>\n        <div class=\"row hot\">\n          <dt>旗舰版 ★</dt>\n          <dd>¥35/月<small>年付 ¥350 · 300GB/月 · 5 台设备</small></dd>\n        </div>\n        <div class=\"row\">\n          <dt>团队版</dt>\n          <dd>¥85/月<small>年付 ¥850 · 1000GB/月 · 20 台设备</small></dd>\n        </div>\n      </dl>\n      <p class=\"panel-foot\">按年付相当于付 10 个月，用 12 个月。中途可按差价升级。</p>\n    </aside>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"features\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">01 · FEATURES</span>\n        <h2 class=\"sec-title\">三件事，说清楚</h2>\n        <p>不堆参数。只讲你关心的。</p>\n      </div>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"tag\">价格透明</span>\n          <h3>标价即实价</h3>\n          <p>月付年付都写在表格里。流量、设备数、节点范围，逐行对齐。买之前看清楚，买之后不扯皮。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">按需选档</span>\n          <h3>三档，不绕弯</h3>\n          <p>一个人用，选基础版。设备多、要看片打游戏，选旗舰版。工作室或小团队，直接上团队版。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">年付优惠</span>\n          <h3>付十用十二</h3>\n          <p>任意套餐按年付，只收 10 个月的钱。基础版年付 ¥150，旗舰版 ¥350，团队版 ¥850。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">02 · PLANS</span>\n        <h2 class=\"sec-title\">套餐对比</h2>\n        <p>横向逐行对照。哪档合适，一眼看出来。</p>\n      </div>\n      <div class=\"table-scroll\">\n        <table class=\"plans\">\n          <thead>\n            <tr>\n              <th>项目</th>\n              <th>\n                <span class=\"p-name\">基础版</span>\n                <span class=\"p-price\">¥15/月</span>\n                <span class=\"p-annual\">按年付仅需 ¥150/年</span>\n              </th>\n              <th class=\"col-featured\">\n                <span class=\"badge\">推荐</span>\n                <span class=\"p-name\">旗舰版</span>\n                <span class=\"p-price\">¥35/月</span>\n                <span class=\"p-annual\">按年付仅需 ¥350/年</span>\n              </th>\n              <th>\n                <span class=\"p-name\">团队版</span>\n                <span class=\"p-price\">¥85/月</span>\n                <span class=\"p-annual\">按年付仅需 ¥850/年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB 极速流量</td>\n              <td class=\"col-featured\">300GB 极速流量</td>\n              <td>1000GB 极速流量</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"col-featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"col-featured\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>节点线路</th>\n              <td>普通线路节点池</td>\n              <td class=\"col-featured\">IPLC 专线，游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>定制能力</th>\n              <td>—</td>\n              <td class=\"col-featured\">—</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持服务</th>\n              <td>标准工单支持</td>\n              <td class=\"col-featured\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>单人日常使用</td>\n              <td class=\"col-featured\">多设备、影音与游戏并重</td>\n              <td>工作室、小团队统一采购</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"plans-note\">说明：以上为刊例价格与权益。流量按自然月重置。套餐间升级按剩余时长折算差价。具体以下单页实时显示为准。</p>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">03 · GUIDE</span>\n        <h2 class=\"sec-title\">使用说明</h2>\n        <p>四步。每步一句话能讲完，但这里多讲两句。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"num\">1</div>\n          <div>\n            <h3>注册账号</h3>\n            <p>用邮箱注册。设置一个够强的密码。账号是你唯一的凭证，别借给别人。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">2</div>\n          <div>\n            <h3>选套餐，完成支付</h3>\n            <p>对照上面的表格选档。月付灵活，年付省两个月。支付成功后套餐立即生效。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">3</div>\n          <div>\n            <h3>获取订阅，导入客户端</h3>\n            <p>在用户中心复制你的订阅链接。打开客户端，选择\"从剪贴板导入\"或\"添加订阅\"。链接等于钥匙，不要外发。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">4</div>\n          <div>\n            <h3>选节点，开始使用</h3>\n            <p>更新订阅后，节点列表自动出现。按延迟排序，挑一个顺手的。用多少流量、剩多少，用户中心随时查。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">04 · CLIENTS</span>\n        <h2 class=\"sec-title\">客户端</h2>\n        <p>按设备数选套餐，按平台装客户端。订阅链接全平台通用。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"os\">WINDOWS / MAC</span>\n          <h3>桌面端</h3>\n          <p>在常用桌面客户端中添加订阅链接即可。支持系统代理与规则模式两种用法，按习惯切换。</p>\n          <a class=\"get\" href=\"#\">下载地址见用户中心</a>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">IOS</span>\n          <h3>苹果移动端</h3>\n          <p>使用 App Store 中的主流客户端，粘贴订阅链接完成导入。一次配置，长期自动更新。</p>\n          <a class=\"get\" href=\"#\">下载地址见用户中心</a>\n        </article>\n        <article class=\"client\">\n          <span class=\"os\">ANDROID</span>\n          <h3>安卓端</h3>\n          <p>安装后从剪贴板导入订阅。可按应用分流，只让需要的应用走代理。</p>\n          <a class=\"get\" href=\"#\">下载地址见用户中心</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">05 · FAQ</span>\n        <h2 class=\"sec-title\">常见问题</h2>\n        <p>问得最多的，先答在这里。</p>\n      </div>\n      <div class=\"faq-grid\">\n        <article class=\"faq\">\n          <h3>流量用超了会怎样？</h3>\n          <p>当月流量用尽后，服务暂停，次月自动恢复。也可以在用户中心升级更高档位，立即获得新的流量额度。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>设备数是怎么算的？</h3>\n          <p>按\"同时在线\"计算，不按安装数量。基础版 3 台同时在线，旗舰版 5 台，团队版 20 台。多装的设备不占用额度，不同时连就行。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>月付能改成年付吗？</h3>\n          <p>可以。在用户中心选择年付，已付的月付余额会按比例折算抵扣。年付价为基础版 ¥150、旗舰版 ¥350、团队版 ¥850。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>套餐之间能升级吗？</h3>\n          <p>能。随时升到更高档，按剩余时长补差价，流量和设备额度立即按新档执行。降级则在当前周期结束后生效。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>订阅链接泄露了怎么办？</h3>\n          <p>立刻在用户中心重置订阅链接。旧链接即刻失效，然后在各客户端重新导入新链接。平时不要把链接发给任何人。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>遇到问题找谁？</h3>\n          <p>先在用户中心提交工单。旗舰版享有 7×24 优先工单通道，团队版配有专属客户经理，响应更快。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p class=\"brandline\">KooDog<span>私家车</span></p>\n    <p>价格透明，说明简短。本页价格与权益以用户中心实时显示为准。</p>\n  </div>\n</footer>",
